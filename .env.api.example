# Default directories used by the Analysis API server when request payload/query params omit them.
API_INPUT_DIR=C:/absolute/path/to/eea-ai-mission-aipossible/data/pages
API_OUTPUT_DIR=C:/absolute/path/to/eea-ai-mission-aipossible/data/analysis
API_EXPORT_DIR=C:/absolute/path/to/eea-ai-mission-aipossible/data/exports

# Default AI provider config used by /v1/analysis/runs.
# Available API_PROVIDER values: mock, openai, eea
API_PROVIDER=mock

# API_MODEL depends on API_PROVIDER.
# Model examples by provider:
# - mock: mock-model
# - openai: gpt-4o, gpt-4o-mini
# - eea: eea-model
# API_MODEL=mock-model

# Optional provider API key override for /v1/analysis/runs.
# API_API_KEY=

# Optional: JSON serialization behavior for analysis output files.
# JSON_ENSURE_ASCII=false
